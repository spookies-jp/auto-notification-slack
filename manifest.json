{
    "name": "Auto Notifier Slack",
    "description": "アクセスしたURLをSlackに通知する",
    "version": "0.1.1",
    "manifest_version": 3,
    "permissions": ["storage", "activeTab"],
    "host_permissions": [
        "https://hooks.slack.com/*"
    ],
    "action": {
        "default_title": "Send to Slack",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "dist/background.js",
        "type": "module"
    }
}
